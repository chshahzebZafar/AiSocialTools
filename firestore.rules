rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Comments are organized under users: users/{userId}/toolComments/{commentId}
    // This allows easy querying by user and future extensions
    
    // CollectionGroup query support - allows querying toolComments across all paths
    // This recursive wildcard pattern is REQUIRED for collectionGroup queries to work
    match /{path=**}/toolComments/{commentId} {
      // Allow anyone to read comments (for displaying on tool pages)
      // This rule supports collectionGroup queries across all user subcollections
      allow read: if true;
      
      // For create/update/delete, we need to ensure the path starts with users/
      // and the userId matches. Since we can't easily parse the path in rules,
      // we'll rely on the specific path rule below for write operations
      // CollectionGroup queries are read-only, so this is fine
    }
    
    // Specific path rule for write operations (create, update, delete)
    // This ensures users can only modify their own comments
    match /users/{userId}/toolComments/{commentId} {
      // Allow anyone to read comments (for displaying on tool pages)
      allow read: if true;
      
      // Only authenticated users can create comments under their own userId
      allow create: if request.auth != null && request.auth.uid == userId;
      
      // Only comment owner can update/delete their own comments
      allow update, delete: if request.auth != null && request.auth.uid == userId;
    }
    
    // Allow users to read their own user document (for profile pages)
    match /users/{userId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow write: if request.auth != null && request.auth.uid == userId;
    }
    
    // Bug reports collection - allow authenticated users to read their own reports
    match /toolBugReports/{bugReportId} {
      // Allow authenticated users to read their own bug reports
      allow read: if request.auth != null && 
                     resource.data.userId == request.auth.uid;
      // Allow authenticated users to create bug reports
      allow create: if request.auth != null && 
                       request.auth.uid == request.resource.data.userId;
      // Allow users to update/delete their own bug reports
      allow update, delete: if request.auth != null && 
                               request.auth.uid == resource.data.userId;
    }
  }
}

