"use client";

import { useCallback, useEffect, useRef, useState } from "react";
import { Wand2, Download, Copy, Check, Loader2, Sparkles, RefreshCw, Shuffle } from "lucide-react";
import { getToolById } from "@/lib/social-tools";
import ToolSEO from "@/components/ToolSEO";
import ToolFAQ from "@/components/ToolFAQ";
import RelatedTools from "@/components/RelatedTools";
import ToolDetailsSection from "@/components/ToolDetailsSection";
import { ToolComments } from "@/components/ToolComments";
import ShareButtons from "@/components/ShareButtons";
import { FavoriteButton } from "@/components/FavoriteButton";

type Model = "flux" | "flux-realism" | "flux-anime" | "flux-3d" | "turbo";

const MODELS: { id: Model; label: string; note: string }[] = [
  { id: "flux", label: "Flux (default)", note: "Best all-round, photorealistic and stylised" },
  { id: "flux-realism", label: "Flux Realism", note: "Hyper-realistic photo output" },
  { id: "flux-anime", label: "Flux Anime", note: "Anime / manga style" },
  { id: "flux-3d", label: "Flux 3D", note: "3D render / Pixar look" },
  { id: "turbo", label: "Turbo", note: "Fastest, lower quality" },
];

const ASPECTS: { label: string; width: number; height: number }[] = [
  { label: "Square 1:1", width: 1024, height: 1024 },
  { label: "Portrait 9:16", width: 720, height: 1280 },
  { label: "Landscape 16:9", width: 1280, height: 720 },
  { label: "Portrait 4:5", width: 1024, height: 1280 },
  { label: "Landscape 3:2", width: 1200, height: 800 },
];

const STYLE_PRESETS: { label: string; suffix: string; emoji: string }[] = [
  { label: "Cinematic", suffix: ", cinematic lighting, dramatic shadows, film still, 35mm", emoji: "🎬" },
  { label: "Photorealistic", suffix: ", photorealistic, 8k, sharp focus, 85mm lens, depth of field", emoji: "📷" },
  { label: "Anime", suffix: ", anime style, vibrant colors, studio ghibli inspired", emoji: "✨" },
  { label: "Minimalist", suffix: ", minimalist, clean lines, soft pastel background, negative space", emoji: "◻️" },
  { label: "Watercolor", suffix: ", watercolor painting, soft brush strokes, artistic, paper texture", emoji: "🎨" },
  { label: "3D render", suffix: ", 3D render, pixar style, soft lighting, smooth textures", emoji: "🧊" },
  { label: "Neon retro", suffix: ", 80s synthwave, neon lights, retro futuristic, vibrant gradients", emoji: "🌆" },
  { label: "Oil painting", suffix: ", oil painting, textured canvas, classical art style", emoji: "🖼️" },
];

const EXAMPLE_PROMPTS = [
  "a golden retriever puppy running through a sunflower field at golden hour",
  "a cozy coffee shop in Tokyo at night, rain on the windows, warm lights",
  "an astronaut floating inside a giant bubble, surreal space scene",
  "a dragon made of autumn leaves, forest background, magical atmosphere",
];

function buildUrl(prompt: string, opts: {
  model: Model;
  width: number;
  height: number;
  seed: number;
  nologo: boolean;
  enhance: boolean;
}): string {
  const params = new URLSearchParams({
    width: String(opts.width),
    height: String(opts.height),
    seed: String(opts.seed),
    model: opts.model,
  });
  if (opts.nologo) params.set("nologo", "true");
  if (opts.enhance) params.set("enhance", "true");
  return `https://image.pollinations.ai/prompt/${encodeURIComponent(prompt)}?${params.toString()}`;
}

export default function AIImageGeneratorPage() {
  const tool = getToolById("ai-image-generator");
  const [prompt, setPrompt] = useState("");
  const [model, setModel] = useState<Model>("flux");
  const [aspectIdx, setAspectIdx] = useState(0);
  const [seed, setSeed] = useState(() => Math.floor(Math.random() * 1_000_000));
  const [enhance, setEnhance] = useState(false);
  const [nologo, setNologo] = useState(true);
  const [pendingUrl, setPendingUrl] = useState<string | null>(null);
  const [currentUrl, setCurrentUrl] = useState<string | null>(null);
  const [currentMeta, setCurrentMeta] = useState<{ prompt: string; seed: number; model: Model; width: number; height: number } | null>(null);
  const [pendingMeta, setPendingMeta] = useState<{ prompt: string; seed: number; model: Model; width: number; height: number } | null>(null);
  const [loading, setLoading] = useState(false);
  const [error, setError] = useState<string | null>(null);
  const [copied, setCopied] = useState(false);
  const [history, setHistory] = useState<{ url: string; prompt: string; seed: number }[]>([]);

  // Pollinations.ai anonymous tier: 1 request per 15 seconds. We track the last
  // request time and enforce a 16-second cooldown on the UI side.
  const [cooldownLeft, setCooldownLeft] = useState(0);
  const lastRequestTs = useRef<number>(0);
  // Dedupe React 19 Strict Mode double-mount firing the same effect twice.
  const lastRequestedUrl = useRef<string | null>(null);

  // Cooldown timer
  useEffect(() => {
    if (cooldownLeft <= 0) return;
    const t = window.setTimeout(() => setCooldownLeft((c) => Math.max(0, c - 1)), 1000);
    return () => window.clearTimeout(t);
  }, [cooldownLeft]);

  // Preload effect. Backoff is 18s/25s — longer than Pollinations' 15-second
  // rate limit — so a rate-limited first attempt has time to expire before the
  // retry fires.
  useEffect(() => {
    if (!pendingUrl || !pendingMeta) return;

    // Strict Mode dedupe: if the effect re-runs with the same URL, skip the
    // duplicate request (Strict Mode runs effects twice in dev).
    if (lastRequestedUrl.current === pendingUrl) return;
    lastRequestedUrl.current = pendingUrl;

    let aborted = false;
    let timers: number[] = [];
    const maxAttempts = 3;

    const attempt = (n: number) => {
      if (aborted) return;
      lastRequestTs.current = Date.now();
      const img = new window.Image();
      img.onload = () => {
        if (aborted) return;
        setCurrentUrl(pendingUrl);
        setCurrentMeta(pendingMeta);
        setLoading(false);
        setError(null);
        setCooldownLeft(15);
        setHistory((h) => {
          if (h[0]?.url === pendingUrl) return h;
          return [{ url: pendingUrl, prompt: pendingMeta.prompt, seed: pendingMeta.seed }, ...h].slice(0, 12);
        });
      };
      img.onerror = () => {
        if (aborted) return;
        if (n < maxAttempts) {
          // Backoff past Pollinations' 15-second rate-limit window
          const delay = n === 1 ? 18000 : 25000;
          // eslint-disable-next-line no-console
          console.log(`[AI Image Generator] attempt ${n} failed (likely rate-limited), retrying in ${Math.round(delay / 1000)}s...`);
          timers.push(window.setTimeout(() => attempt(n + 1), delay));
          return;
        }
        setLoading(false);
        setError(
          "Pollinations wouldn't serve this image. Free anonymous usage is limited to 1 image per 15 seconds. Please wait a minute and try again with a shorter prompt."
        );
      };
      img.src = n === 1 ? pendingUrl : `${pendingUrl}&r=${n}`;
    };

    attempt(1);

    const totalTimeout = window.setTimeout(() => {
      if (aborted) return;
      aborted = true;
      setLoading(false);
      setError("Request timed out — Pollinations may be overloaded. Please try again shortly.");
    }, 120000);
    timers.push(totalTimeout);

    return () => {
      aborted = true;
      timers.forEach((t) => window.clearTimeout(t));
      timers = [];
    };
  }, [pendingUrl, pendingMeta]);

  const applyPreset = (suffix: string) => {
    setPrompt((p) => (p.endsWith(suffix) ? p : `${p.trim().replace(/[,\s]+$/, "")}${suffix}`));
  };

  const useExample = (ex: string) => setPrompt(ex);

  const generate = useCallback((overrideSeed?: number) => {
    const clean = prompt.trim();
    if (!clean) {
      setError("Please enter a prompt first.");
      return;
    }
    const aspect = ASPECTS[aspectIdx];
    const useSeed = overrideSeed ?? seed;
    const url = buildUrl(clean, {
      model,
      width: aspect.width,
      height: aspect.height,
      seed: useSeed,
      nologo,
      enhance,
    });
    const meta = { prompt: clean, seed: useSeed, model, width: aspect.width, height: aspect.height };

    setError(null);
    setLoading(true);
    setPendingUrl(url);
    setPendingMeta(meta);
    if (overrideSeed !== undefined) setSeed(overrideSeed);
  }, [prompt, aspectIdx, model, seed, enhance, nologo]);

  const reroll = () => generate(Math.floor(Math.random() * 1_000_000));

  const download = async () => {
    if (!currentUrl) return;
    try {
      const res = await fetch(currentUrl);
      const blob = await res.blob();
      const objectUrl = URL.createObjectURL(blob);
      const a = document.createElement("a");
      a.href = objectUrl;
      a.download = `ai-image-${currentMeta?.seed ?? Date.now()}.png`;
      a.click();
      URL.revokeObjectURL(objectUrl);
    } catch {
      window.open(currentUrl, "_blank", "noopener");
    }
  };

  const copyUrl = async () => {
    if (!currentUrl) return;
    await navigator.clipboard.writeText(currentUrl);
    setCopied(true);
    setTimeout(() => setCopied(false), 1500);
  };

  return (
    <>
      {tool && <ToolSEO tool={tool} />}
      <div className="p-8 max-w-6xl mx-auto">
        <div className="mb-8">
          <div className="flex items-center gap-3 mb-4">
            <div className="w-12 h-12 bg-gradient-to-br from-violet-500 via-fuchsia-500 to-pink-500 rounded-lg flex items-center justify-center">
              <Wand2 className="w-6 h-6 text-white" />
            </div>
            <div className="flex-1">
              <h1 className="text-3xl font-bold text-slate-900 dark:text-slate-100">
                AI Image Generator — Free, No Signup, No Watermark
              </h1>
              <p className="text-slate-600 dark:text-slate-300">
                Turn any text prompt into stunning AI images using Flux, SDXL, and specialised models (realism, anime, 3D). Completely free, unlimited, and runs in your browser.
              </p>
            </div>
          </div>
          <div className="mt-4 flex items-center gap-3 flex-wrap">
            {tool && <FavoriteButton toolId={tool.id} />}
            <ShareButtons title="AI Image Generator" text="Free AI image generator — Flux & SDXL, no signup, no watermark." />
          </div>
        </div>

        <div className="grid grid-cols-1 lg:grid-cols-5 gap-6">
          {/* Controls */}
          <div className="lg:col-span-2 bg-white dark:bg-slate-800 rounded-xl shadow-sm border border-slate-200 dark:border-slate-700 p-6 space-y-5">
            <div>
              <label className="block text-sm font-medium text-slate-700 dark:text-slate-200 mb-2">
                Prompt
              </label>
              <textarea
                value={prompt}
                onChange={(e) => setPrompt(e.target.value)}
                placeholder="Describe your image — subject, style, lighting, composition..."
                rows={4}
                className="w-full px-4 py-3 border border-slate-300 dark:border-slate-600 bg-white dark:bg-slate-900 rounded-lg focus:ring-2 focus:ring-fuchsia-500 focus:border-fuchsia-500 resize-none"
              />
              <div className="mt-2 flex flex-wrap gap-1.5">
                {EXAMPLE_PROMPTS.map((ex) => (
                  <button
                    key={ex}
                    onClick={() => useExample(ex)}
                    className="text-xs px-2 py-1 rounded-full bg-slate-100 dark:bg-slate-900/40 hover:bg-slate-200 dark:hover:bg-slate-700 text-slate-700 dark:text-slate-300 border border-slate-200 dark:border-slate-700 transition"
                  >
                    {ex.slice(0, 32)}...
                  </button>
                ))}
              </div>
            </div>

            <div>
              <label className="block text-sm font-medium text-slate-700 dark:text-slate-200 mb-2">Style presets (click to append)</label>
              <div className="flex flex-wrap gap-1.5">
                {STYLE_PRESETS.map((s) => (
                  <button
                    key={s.label}
                    onClick={() => applyPreset(s.suffix)}
                    className="text-xs px-3 py-1.5 rounded-full border border-slate-200 dark:border-slate-700 bg-slate-50 dark:bg-slate-900/40 hover:bg-fuchsia-50 dark:hover:bg-fuchsia-900/20 hover:border-fuchsia-300 dark:hover:border-fuchsia-700 text-slate-800 dark:text-slate-100 transition"
                  >
                    <span className="mr-1">{s.emoji}</span>{s.label}
                  </button>
                ))}
              </div>
            </div>

            <div>
              <label className="block text-sm font-medium text-slate-700 dark:text-slate-200 mb-2">Model</label>
              <select
                value={model}
                onChange={(e) => setModel(e.target.value as Model)}
                className="w-full px-4 py-2 border border-slate-300 dark:border-slate-600 bg-white dark:bg-slate-900 rounded-lg"
              >
                {MODELS.map((m) => (
                  <option key={m.id} value={m.id}>{m.label} — {m.note}</option>
                ))}
              </select>
            </div>

            <div>
              <label className="block text-sm font-medium text-slate-700 dark:text-slate-200 mb-2">Aspect ratio</label>
              <div className="grid grid-cols-2 gap-2">
                {ASPECTS.map((a, i) => (
                  <button
                    key={a.label}
                    onClick={() => setAspectIdx(i)}
                    className={`px-3 py-2 rounded-lg border text-sm transition ${
                      aspectIdx === i
                        ? "border-fuchsia-500 bg-fuchsia-50 dark:bg-fuchsia-900/30 text-fuchsia-700 dark:text-fuchsia-200"
                        : "border-slate-200 dark:border-slate-700 text-slate-600 dark:text-slate-300 hover:bg-slate-50 dark:hover:bg-slate-700"
                    }`}
                  >
                    {a.label}
                    <span className="block text-[10px] opacity-75">{a.width}×{a.height}</span>
                  </button>
                ))}
              </div>
            </div>

            <div className="space-y-2">
              <label className="flex items-center gap-2 text-sm text-slate-700 dark:text-slate-200 cursor-pointer">
                <input type="checkbox" checked={enhance} onChange={(e) => setEnhance(e.target.checked)} className="accent-fuchsia-500" />
                <span>Enhance prompt <span className="text-xs text-slate-500">(AI rewrite — can 500 under load)</span></span>
              </label>
              <label className="flex items-center gap-2 text-sm text-slate-700 dark:text-slate-200 cursor-pointer">
                <input type="checkbox" checked={nologo} onChange={(e) => setNologo(e.target.checked)} className="accent-fuchsia-500" />
                Remove Pollinations logo
              </label>
              <div className="flex items-center gap-2 text-sm text-slate-700 dark:text-slate-200">
                <label className="flex-1">Seed:</label>
                <input
                  type="number"
                  value={seed}
                  onChange={(e) => setSeed(Number(e.target.value) || 0)}
                  className="w-28 px-2 py-1 border border-slate-300 dark:border-slate-600 bg-white dark:bg-slate-900 rounded text-xs"
                />
                <button
                  onClick={() => setSeed(Math.floor(Math.random() * 1_000_000))}
                  className="p-1 rounded hover:bg-slate-100 dark:hover:bg-slate-700"
                  title="Random seed"
                >
                  <Shuffle className="w-4 h-4" />
                </button>
              </div>
            </div>

            <button
              onClick={() => generate()}
              disabled={loading || !prompt.trim() || cooldownLeft > 0}
              className="w-full bg-gradient-to-r from-violet-600 via-fuchsia-600 to-pink-600 hover:from-violet-700 hover:via-fuchsia-700 hover:to-pink-700 text-white px-6 py-3 rounded-lg font-semibold shadow-lg shadow-fuchsia-500/30 disabled:opacity-50 disabled:cursor-not-allowed transition flex items-center justify-center gap-2"
            >
              {loading ? <Loader2 className="w-5 h-5 animate-spin" /> : <Sparkles className="w-5 h-5" />}
              {loading
                ? "Generating..."
                : cooldownLeft > 0
                ? `Wait ${cooldownLeft}s...`
                : "Generate image"}
            </button>

            {error && <p className="text-sm text-red-600 dark:text-red-400">{error}</p>}

            <div className="text-xs text-slate-500 dark:text-slate-400 bg-slate-50 dark:bg-slate-900/40 border border-slate-200 dark:border-slate-700 rounded-lg p-3">
              <p className="font-semibold text-slate-700 dark:text-slate-200 mb-1">⏱️ Rate limit notice</p>
              <p>Pollinations free tier allows <strong>1 image every 15 seconds</strong>. The Generate button disables during cooldown. For higher limits, <a href="https://auth.pollinations.ai" target="_blank" rel="noopener noreferrer" className="underline text-fuchsia-600 dark:text-fuchsia-400">sign up at auth.pollinations.ai</a>.</p>
            </div>
          </div>

          {/* Preview */}
          <div className="lg:col-span-3 bg-white dark:bg-slate-800 rounded-xl shadow-sm border border-slate-200 dark:border-slate-700 p-6">
            {!currentUrl && !loading && (
              <div className="flex flex-col items-center justify-center h-96 text-center text-slate-500 dark:text-slate-400 border-2 border-dashed border-slate-200 dark:border-slate-700 rounded-lg">
                <Wand2 className="w-12 h-12 mb-3 text-fuchsia-500" />
                <p className="font-medium text-slate-700 dark:text-slate-200">Your AI image will appear here</p>
                <p className="text-sm mt-1">Enter a prompt and click Generate.</p>
              </div>
            )}

            {loading && (
              <div className="flex flex-col items-center justify-center h-96 text-slate-500 dark:text-slate-400 border border-slate-200 dark:border-slate-700 rounded-lg bg-gradient-to-br from-violet-50/50 to-pink-50/50 dark:from-violet-900/10 dark:to-pink-900/10">
                <Loader2 className="w-12 h-12 animate-spin mb-3 text-fuchsia-500" />
                <p className="text-sm">Painting your image... usually 5–15 seconds.</p>
                <p className="text-xs mt-1 opacity-75">Flux is a diffusion model — first generation with a new prompt takes longer.</p>
              </div>
            )}

            {currentUrl && !loading && (
              <>
                <div className="relative rounded-lg overflow-hidden border border-slate-200 dark:border-slate-700 bg-slate-100 dark:bg-slate-900">
                  {/* eslint-disable-next-line @next/next/no-img-element */}
                  <img
                    key={currentUrl}
                    src={currentUrl}
                    alt={currentMeta?.prompt || "AI generated image"}
                    className="w-full h-auto block"
                  />
                </div>
                <div className="mt-4 flex flex-wrap gap-2">
                  <button onClick={download} className="inline-flex items-center gap-2 px-4 py-2 bg-slate-900 dark:bg-white text-white dark:text-slate-900 rounded-lg text-sm font-medium hover:opacity-90">
                    <Download className="w-4 h-4" /> Download PNG
                  </button>
                  <button
                    onClick={reroll}
                    disabled={cooldownLeft > 0}
                    className="inline-flex items-center gap-2 px-4 py-2 border border-slate-200 dark:border-slate-600 hover:bg-slate-50 dark:hover:bg-slate-700 rounded-lg text-sm font-medium disabled:opacity-50 disabled:cursor-not-allowed"
                  >
                    <RefreshCw className="w-4 h-4" />
                    {cooldownLeft > 0 ? `Re-roll in ${cooldownLeft}s` : "Re-roll (new seed)"}
                  </button>
                  <button onClick={copyUrl} className="inline-flex items-center gap-2 px-4 py-2 border border-slate-200 dark:border-slate-600 hover:bg-slate-50 dark:hover:bg-slate-700 rounded-lg text-sm font-medium">
                    {copied ? <Check className="w-4 h-4 text-green-600" /> : <Copy className="w-4 h-4" />}
                    {copied ? "Copied" : "Copy image URL"}
                  </button>
                </div>
                {currentMeta && (
                  <div className="mt-3 text-xs text-slate-500 dark:text-slate-400 space-y-0.5">
                    <p><span className="font-semibold">Prompt:</span> {currentMeta.prompt}</p>
                    <p><span className="font-semibold">Seed:</span> {currentMeta.seed} · <span className="font-semibold">Model:</span> {currentMeta.model} · <span className="font-semibold">Size:</span> {currentMeta.width}×{currentMeta.height}</p>
                  </div>
                )}
              </>
            )}
          </div>
        </div>

        {history.length > 1 && (
          <div className="mt-6 bg-white dark:bg-slate-800 rounded-xl shadow-sm border border-slate-200 dark:border-slate-700 p-6">
            <h2 className="text-lg font-semibold text-slate-900 dark:text-slate-100 mb-4">Recent generations</h2>
            <div className="grid grid-cols-3 sm:grid-cols-4 md:grid-cols-6 gap-3">
              {history.map((h, i) => (
                <button
                  key={`${h.url}-${i}`}
                  onClick={() => {
                    setCurrentUrl(h.url);
                    setPrompt(h.prompt);
                    setSeed(h.seed);
                  }}
                  className="group relative aspect-square rounded-lg overflow-hidden border border-slate-200 dark:border-slate-700 hover:ring-2 hover:ring-fuchsia-500 transition"
                >
                  {/* eslint-disable-next-line @next/next/no-img-element */}
                  <img src={h.url} alt={`Recent generation: ${h.prompt}`} className="w-full h-full object-cover" />
                </button>
              ))}
            </div>
          </div>
        )}

        <div className="mt-8 bg-gradient-to-br from-fuchsia-50 to-violet-50 dark:from-fuchsia-900/20 dark:to-violet-900/20 border border-fuchsia-200 dark:border-fuchsia-800 rounded-xl p-5 text-sm text-fuchsia-900 dark:text-fuchsia-100">
          <p className="font-semibold mb-2">💡 Prompt tips</p>
          <ul className="space-y-1">
            <li>&bull; Be specific: <em>&ldquo;a red vintage bicycle leaning on a stone wall in Provence, soft morning light&rdquo;</em> &gt; <em>&ldquo;a bike&rdquo;</em></li>
            <li>&bull; Add art direction: lens (85mm, wide-angle), lighting (golden hour, neon, studio), style (oil painting, cinematic, anime)</li>
            <li>&bull; Use negative framing only if needed — Flux usually understands intent without explicit negatives</li>
            <li>&bull; Same prompt + same seed = same image. Change the seed to get variations.</li>
          </ul>
        </div>

        {tool && <ToolComments toolId={tool.id} />}
        {tool && <ToolFAQ tool={tool} />}
        {tool && <RelatedTools currentTool={tool} />}
        {tool && <ToolDetailsSection tool={tool} />}
      </div>
    </>
  );
}
